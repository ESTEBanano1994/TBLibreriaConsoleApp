<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="411.0" prefWidth="910.0" style="-fx-background-color: #E5D2B3;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tb.controller.CategoriaFXController">
<padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
 
    <left>
<VBox maxWidth="300" minWidth="300" spacing="10" style="-fx-background-color: #EFE1C7;">
<padding><Insets right="20" /></padding>
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Categoria" />
<TextField fx:id="txtCui" promptText="ID" />
<TextField fx:id="txtNombre" promptText="NombreCategoria" />
<HBox spacing="10">
<Button onAction="#handleGuardar" prefWidth="120" style="-fx-background-color: #51201F; -fx-border-color: #C3A885; -fx-cursor: red;" text="Guardar" textFill="WHITE" />
<Button onAction="#handleLimpiar" prefWidth="120" style="-fx-background-color: #51201F; -fx-border-color: #C3A885;" text="Limpiar" textFill="WHITE" />
</HBox>
<Label fx:id="lblMensaje" />
</VBox>
</left>
 
    <center>
<VBox prefHeight="369.0" prefWidth="396.0" spacing="10">
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Categorias" />
<TableView fx:id="tablaClientes" prefHeight="251.0" prefWidth="439.0" style="-fx-background-color: #E5D2B3;">
<columns>
<TableColumn fx:id="colID" prefWidth="165.0" style="-fx-background-color: white; Font: red;" text="ID">
<cellValueFactory>
<PropertyValueFactory property="cui" />
</cellValueFactory>
</TableColumn>
<TableColumn fx:id="colNombreCategoria" prefWidth="404.0" style="-fx-background-color: white;" text="NombreCategoria">
<cellValueFactory>
<PropertyValueFactory property="nombre" />
</cellValueFactory>
</TableColumn>
</columns>
</TableView>
<HBox spacing="10">
<Button onAction="#handleActualizar" style="-fx-background-color: #51201F;" text="Actualizar Tabla" textFill="WHITE" />
<Button onAction="#handleVolver" style="-fx-background-color: #51201F;" text="Volver al Menú" textFill="WHITE" />
</HBox>
</VBox>
</center>
</BorderPane>
