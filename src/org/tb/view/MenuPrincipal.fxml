<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tb.controller.MenuPrincipalController">
    <top>
        <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="TB Librería - Menú Principal" textFill="#750d0d" BorderPane.alignment="CENTER">
            <padding><Insets top="20" /></padding>
        </Label>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #E5D2B3;">
            <padding><Insets bottom="30" left="40" right="40" top="30" /></padding>
            <Button onAction="#handleClientes" prefHeight="40" prefWidth="220" style="-fx-background-color: #51201F;" text="Clientes" textFill="#eeeeee" />
            <Button onAction="#handleNoDisponible" prefHeight="40" prefWidth="220" style="-fx-background-color: #51201F;" text="Autores" textFill="WHITE" />
            <Button onAction="#handleNoDisponible" prefHeight="40" prefWidth="220" style="-fx-background-color: #51201F;" text="Categorías" textFill="WHITE" />
            <Button onAction="#handleNoDisponible" prefHeight="40" prefWidth="220" style="-fx-background-color: #51201F;" text="Editoriales" textFill="WHITE" />
            <Button onAction="#handleSalir" prefHeight="40" prefWidth="220" style="-fx-background-color: #51201F;" text="Salir" textFill="#fffafa" />
        </VBox>
    </center>
</BorderPane>
