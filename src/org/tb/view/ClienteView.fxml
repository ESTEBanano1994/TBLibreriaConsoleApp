<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
 
<BorderPane prefHeight="363.0" prefWidth="712.0" style="-fx-background-color: #E5D2B3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tb.controller.ClienteFXController">
<padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
 
    <left>
<VBox maxWidth="300" minWidth="300" spacing="10" style="-fx-background-color: #EFE1C7;">
<padding><Insets right="20" /></padding>
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Cliente" />
<TextField fx:id="txtCui" promptText="CUI" />
<TextField fx:id="txtNombre" promptText="Nombre" />
<TextField fx:id="txtApellido" promptText="Apellido" />
<TextField fx:id="txtCorreo" promptText="Correo Electrónico" />
<HBox spacing="10">
<Button onAction="#handleGuardar" prefWidth="120" style="-fx-background-color: #51201F; -fx-border-color: #C3A885; -fx-cursor: red;" text="Guardar" textFill="WHITE" />
<Button onAction="#handleLimpiar" prefWidth="120" style="-fx-background-color: #51201F; -fx-border-color: #C3A885;" text="Limpiar" textFill="WHITE" />
</HBox>
<Label fx:id="lblMensaje" />
</VBox>
</left>
 
    <center>
<VBox spacing="10">
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Clientes" />
<TableView fx:id="tablaClientes" prefHeight="251.0" prefWidth="439.0" style="-fx-background-color: #E5D2B3;">
<columns>
<TableColumn prefWidth="120" style="-fx-background-color: white; Font: red;" text="CUI">
<cellValueFactory>
<PropertyValueFactory property="cui" />
</cellValueFactory>
</TableColumn>
<TableColumn prefWidth="140" style="-fx-background-color: white;" text="Nombre">
<cellValueFactory>
<PropertyValueFactory property="nombre" />
</cellValueFactory>
</TableColumn>
<TableColumn prefWidth="101.0" style="-fx-background-color: white;" text="Apellido">
<cellValueFactory>
<PropertyValueFactory property="apellido" />
</cellValueFactory>
</TableColumn>
<TableColumn prefWidth="239.0" style="-fx-background-color: White;" text="Correo Electrónico">
<cellValueFactory>
<PropertyValueFactory property="correoElectronico" />
</cellValueFactory>
</TableColumn>
</columns>
</TableView>
<HBox spacing="10">
<Button onAction="#handleActualizar" text="Actualizar Tabla" />
<Button onAction="#handleVolver" text="Volver al Menú" />
</HBox>
</VBox>
</center>
</BorderPane>