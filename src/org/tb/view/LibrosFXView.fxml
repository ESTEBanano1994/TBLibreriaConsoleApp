<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="337.0" prefWidth="946.0" style="-fx-background-color: #E5D2B3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tb.controller.LibrosFXController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
 
    <left>
        <VBox maxWidth="300" minWidth="275.0" prefHeight="352.0" prefWidth="275.0" spacing="10" style="-fx-background-color: #EFE1C7;">
            <padding>
                <Insets right="20" />
            </padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Libros" textFill="#51201f" />
            <TextField fx:id="txtIsbn" promptText="ISBN" />
            <TextField fx:id="txtTitulo" promptText="Titulo" />
            <TextField fx:id="txtFechaPublicacion" promptText="Fecha de Publicación" />
            <TextField fx:id="txtPrecio" promptText="Precio" />
         <TextField promptText="ID" />
         <TextField promptText="Nit" />
            <HBox spacing="10" />
             <Button alignment="CENTER" onAction="#handleGuardar" prefHeight="27.0" prefWidth="90.0" style="-fx-background-color: #51201F; -fx-border-color: #C3A885; -fx-cursor: default;" text="Guardar" textFill="WHITE" />
             <Button onAction="#handleLimpiar" prefHeight="27.0" prefWidth="91.0" style="-fx-background-color: #51201F; -fx-border-color: #C3A885;" text="Limpiar" textAlignment="CENTER" textFill="WHITE" />
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>
 
    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Tabla de Libros" textFill="#51201f" />
            <TableView fx:id="tablaEditoriales" prefHeight="217.0" prefWidth="253.0">
                <columns>
                    <TableColumn fx:id="colNit" prefWidth="120" style="-fx-background-color: Red Font: White" text="ISBN" />

                    <TableColumn fx:id="colNombre" prefWidth="140" style="-fx-background-color: white;" text="Titulos" />

                    <TableColumn fx:id="colTelefono" prefWidth="101.0" style="-fx-background-color: white;" text="Fecha Publicación" />

                    <TableColumn fx:id="colDireccion" prefWidth="239.0" style="-fx-background-color: White;" text="Precio" />
                </columns>
                </TableView>
                    <HBox spacing="10">
                        <Button onAction="#handleActualizar" prefHeight="25.0" prefWidth="256.0" style="-fx-background-color: #51201F;" text="Actualizar Tabla" textFill="WHITE" />
                        <Button onAction="#handleVolver" prefHeight="25.0" prefWidth="306.0" style="-fx-background-color: #51201F;" text="Volver al Menú" textFill="WHITE" />
                    </HBox>
        </VBox>
    </center>
</BorderPane>
