<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="398.0" prefWidth="923.0" style="-fx-background-color: #E5D2B3;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tb.controller.EditorialFXController">
<padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
 
    <left>
<VBox maxWidth="300" minWidth="300" spacing="10" style="-fx-background-color: #EFE1C7;">
<padding><Insets right="20" /></padding>
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Editoriales" textFill="#51201f" />
<TextField fx:id="txtNit" promptText="NIT" />
<TextField fx:id="txtNombre" promptText="Nombre" />
<TextField fx:id="txtTelefono" promptText="Telefono" />
<TextField fx:id="txtDireccion" promptText="Dirección" />
<HBox spacing="10">
<Button onAction="#handleGuardar" prefWidth="120" style="-fx-background-color: #51201F; -fx-border-color: #C3A885; -fx-cursor: default;" text="Guardar" textFill="WHITE" />
<Button onAction="#handleLimpiar" prefWidth="120" style="-fx-background-color: #51201F; -fx-border-color: #C3A885;" text="Limpiar" textFill="WHITE" />
</HBox>
<Label fx:id="lblMensaje" />
</VBox>
</left>
 
    <center>
<VBox spacing="10">
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Tabla Editoriales" textFill="#51201f" />
<TableView fx:id="tablaEditoriales" prefHeight="251.0" prefWidth="439.0">
<columns>
<TableColumn fx:id="colNit" prefWidth="120" style="-fx-background-color: Red Font: White" text="Nit">
<cellValueFactory>
<PropertyValueFactory property="cui" />
</cellValueFactory>
</TableColumn>
<TableColumn fx:id="colNombre" prefWidth="140" style="-fx-background-color: white;" text="Nombre">
<cellValueFactory>
<PropertyValueFactory property="nombre" />
</cellValueFactory>
</TableColumn>
<TableColumn fx:id="colTelefono" prefWidth="101.0" style="-fx-background-color: white;" text="Telefono">
<cellValueFactory>
<PropertyValueFactory property="apellido" />
</cellValueFactory>
</TableColumn>
<TableColumn fx:id="colDireccion" prefWidth="239.0" style="-fx-background-color: White;" text="Dirección">
<cellValueFactory>
<PropertyValueFactory property="correoElectronico" />
</cellValueFactory>
</TableColumn>
</columns>
</TableView>
<HBox spacing="10">
      <Button onAction="#handleActualizar" prefHeight="25.0" prefWidth="256.0" style="-fx-background-color: #51201F;" text="Actualizar Tabla" textFill="WHITE" />
   <Button onAction="#handleVolver" prefHeight="25.0" prefWidth="306.0" style="-fx-background-color: #51201F;" text="Volver al Menú" textFill="WHITE" />
</HBox>
</VBox>
</center>
</BorderPane>
